{
    "name": "nafeesahmed1431/enapi",
    "description": "Dynamic API package for building REST APIs with automatic CRUD generation and model-based architecture",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nafees Ahmed",
            "email": "nafeesahmed1431@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "suggest": {
        "illuminate/support": "Required for Laravel integration (^8.0|^9.0|^10.0|^11.0)",
        "illuminate/database": "Required for Laravel Eloquent integration (^8.0|^9.0|^10.0|^11.0)"
    },
    "autoload": {
        "psr-4": {
            "NafeesAhmed\\Enapi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NafeesAhmed\\Enapi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NafeesAhmed\\Enapi\\Laravel\\LaravelServiceProvider"
            ]
        }
    },
    "keywords": [
        "api",
        "rest",
        "dynamic",
        "crud",
        "orm",
        "database",
        "pdo",
        "model",
        "mvc",
        "laravel",
        "eloquent"
    ],
    "support": {
        "issues": "https://github.com/nafeesAhmed1431/enapi/issues",
        "source": "https://github.com/nafeesAhmed1431/enapi"
    }
}
